---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Bird from '../components/Bird.astro';
import BranchDivider from '../components/BranchDivider.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import Keep from '../components/Keep.astro';
import ChartTeaser from '../components/ChartTeaser.astro';
import SeasonTimeline from '../components/SeasonTimeline.astro';
import SoundChecker from '../components/SoundChecker.astro';
import { faqs, listPerks, site } from '../data/site';
import { posts } from '../data/posts';
import heroPhoto from '../assets/images/hero-group-portrait.jpg';
import mollyPortrait from '../assets/images/headshot-portrait.png';
import ashaBadge from '../assets/images/asha-certified.png';
import groupPhoto from '../assets/images/gallery-3.jpg';
import gallery1 from '../assets/images/gallery-1.jpg';
import gallery2 from '../assets/images/gallery-2.jpg';
import gallery4 from '../assets/images/gallery-4.jpg';
import gallery5 from '../assets/images/gallery-5.jpg';
import gallery6 from '../assets/images/gallery-6.jpg';

const { groups } = site;

const gallery = [
  { src: gallery2, alt: 'Molly reading a picture book with a young boy in a park', r: '-2deg' },
  { src: gallery1, alt: 'Molly telling a felt-board story to three children under a tree', r: '1.5deg' },
  { src: gallery4, alt: 'Molly reading a story with a young girl at home', r: '-1deg' },
  { src: gallery5, alt: 'Molly and a boy laughing together during a play-based activity', r: '2deg' },
  { src: gallery6, alt: 'Molly walking hand in hand with two young girls in a park', r: '-1.5deg' },
];

const whatCards = [
  {
    icon: 'friends',
    title: 'Small groups',
    text: 'Kids practice with a few peers working on similar sounds, so speech practice feels normal and even fun.',
  },
  {
    icon: 'clock',
    title: `${groups.minutes} playful minutes`,
    text: 'Games, stories, and movement built around your child’s sounds. Long enough for real practice, short enough to stay fun.',
  },
  {
    icon: 'tag',
    title: `$${groups.price} a session`,
    text: 'Simple private pay. No insurance paperwork and no long-term contract.',
  },
] as const;

const groupPoints = [
  'Kids learn by hearing each other try',
  'Practice feels like play, not a test',
  'Confidence grows when no one feels singled out',
];

const latest = posts[0];
---

<Layout title="Speech Sound Groups for Kids in Kansas City" footerPromo={false}>
  <!-- Hero -->
  <section class="relative isolate overflow-clip">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x grid grid-cols-1 items-center gap-16 pb-20 pt-8 lg:grid-cols-[1.06fr_0.94fr] lg:gap-14 lg:pb-28 lg:pt-12">
      <div class="max-w-[38rem]">
        <p class="eyebrow load-in">
          {site.launch.badge}<span class="sep"> <span aria-hidden="true">·</span> </span><span class="sm:hidden">{site.launch.eyebrowShort}</span><span class="hidden sm:inline">{site.launch.eyebrow}</span>
        </p>
        <h1 class="display mt-6 load-in" style="--d:1">
          Help your child <span class="accent">find their <span class="squiggle-wrap">voice<svg
                class="squiggle"
                viewBox="0 0 200 20"
                preserveAspectRatio="none"
                aria-hidden="true"><path pathLength="1" d="M4 13C40 5 70 17 104 10s56-7 92 2"></path></svg
              ></span></span>
        </h1>
        <p class="lead mt-6 load-in" style="--d:2">
          Sound Groups are a new way to work on speech sounds: small, <span class="whitespace-nowrap">play-based</span> sessions
          where kids practice together, led by an experienced pediatric
          <span class="whitespace-nowrap">speech-language</span> pathologist. Think of it as a class, just for speech.
        </p>
        <div class="btn-row mt-9 load-in" style="--d:3">
          <a href="/register/" class="btn btn-primary btn-lg">
            Join the priority list
            <Icon name="arrow" class="arrow" size={20} />
          </a>
          <a href="/speech-sound-chart/" class="btn btn-secondary btn-lg">Check your child’s sounds</a>
        </div>
        <ul class="reassure mt-6 load-in" style="--d:4">
          <li><Icon name="check" size={18} strokeWidth={2.2} />Free to join</li>
          <li><Icon name="check" size={18} strokeWidth={2.2} />No commitment</li>
          <li><Icon name="check" size={18} strokeWidth={2.2} />Takes 2 minutes</li>
        </ul>
      </div>

      <figure class="relative mx-auto w-full max-w-[25rem] pl-2 pr-3 sm:max-w-[28rem] sm:px-0 lg:mr-4 lg:max-w-[30rem]">
        <!-- --ar is the arch's width / height (4 / 4.7). -->
        <div class="arch-frame" style="--ar:.851">
          <div class="arch arch-reveal aspect-[4/4.7]">
            <Picture
              src={heroPhoto}
              formats={['avif', 'webp']}
              widths={[420, 640, 860, 1100]}
              width={1100}
              sizes="(min-width: 1024px) 30rem, (min-width: 640px) 28rem, 90vw"
              alt="Molly Kolarik telling a felt-board story to three young children under a tree"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <span class="seal load-in" style="--d:5">
          <Image src={ashaBadge} alt="ASHA certified, CCC-SLP" width={80} densities={[1, 2]} />
        </span>
        <figcaption class="mt-9 text-center load-in" style="--d:6">
          <p class="text-[0.95rem] font-medium text-ink">Molly Kolarik, <span class="text-muted">{site.credentials}</span></p>
          <div class="plate mt-4">
            <div><strong>${groups.price}</strong><span>per session</span></div>
            <div><strong>{groups.minutes}</strong><span>minutes</span></div>
            <div><strong>{groups.minAge}+</strong><span>years old</span></div>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-tan bg-white/60" aria-label="About Molly at a glance">
    <ul class="container-x flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5 text-[0.95rem] text-muted">
      <li class="inline-flex items-center gap-2"><Icon name="sprig" size={20} class="text-sage-600" />Experienced pediatric SLP</li>
      <li class="inline-flex items-center gap-2"><Icon name="cap" size={20} class="text-sage-600" />M.S., CCC-SLP</li>
      <li class="inline-flex items-center gap-2"><Icon name="shield" size={20} class="text-sage-600" />ASHA certified</li>
      <li class="inline-flex items-center gap-2"><Icon name="heart" size={20} class="text-sage-600" />Kansas City mom</li>
    </ul>
  </section>

  <!-- What is a Sound Group -->
  <section class="section">
    <div class="container-x">
      <BranchDivider class="mb-10" />
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker reveal">What’s a Sound Group?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Part class, <span class="accent">part playdate</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Kids learn alongside a few peers, with expert guidance, in a setting that feels like an activity rather than an
          appointment.
        </p>
      </div>
      <ul class="ledger mt-14">
        {
          whatCards.map((card, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="icon-badge">
                <Icon name={card.icon} size={24} strokeWidth={1.6} />
              </span>
              <h3>{card.title}</h3>
              <p><Keep text={card.text} /></p>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center reveal">
        <a href="/sound-groups/" class="text-link">How Sound Groups work <Icon name="arrow" size={16} class="arrow" /></a>
      </p>
    </div>
  </section>

  <!-- Photo strip -->
  <section class="relative bg-sage-100/70 py-8" aria-label="Photos of Molly with children" data-marquee>
    <div class="marquee">
      <div class="marquee-track">
        {
          [...gallery, ...gallery].map((photo, i) => (
            <figure class="polaroid" style={`--r:${photo.r}`} aria-hidden={i >= gallery.length ? 'true' : undefined}>
              <Image
                src={photo.src}
                alt={i >= gallery.length ? '' : photo.alt}
                widths={[300, 560]}
                width={560}
                sizes="(min-width: 768px) 17rem, 13rem"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>
    </div>
    <button type="button" class="marquee-toggle" aria-pressed="false" data-marquee-toggle>
      <span class="sr-only">Pause the photos</span>
      <Icon name="pause" size={18} strokeWidth={2.4} class="icon-pause" />
      <Icon name="play" size={18} strokeWidth={2} class="icon-play" />
    </button>
  </section>

  <!-- Why groups -->
  <section class="section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <div class="overflow-hidden rounded-[1.75rem]">
          <Image
            src={groupPhoto}
            alt="A girl grinning as she sits in the grass with other kids during an outdoor activity"
            widths={[480, 760, 1100]}
            width={1100}
            sizes="(min-width: 1024px) 34rem, 92vw"
            class="aspect-[4/3] h-auto w-full object-cover object-[42%_50%]"
          />
        </div>
      </div>
      <div>
        <p class="kicker reveal">Why groups?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Kids thrive <span class="accent">alongside peers</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Practicing with a few other kids makes speech work feel normal, social, and fun, and the progress carries into
          everyday conversations at school and at home.
        </p>
        <ul class="mt-8 space-y-4">
          {
            groupPoints.map((point, i) => (
              <li class="flex items-start gap-4 text-ink reveal" style={`--i:${i + 3}`}>
                <span class="check-dot mt-0.5">
                  <Icon name="check" size={15} strokeWidth={2.6} />
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 reveal" style="--i:6">
          <a href="/blog/why-kids-thrive-in-group-speech-therapy/" class="text-link">Why kids thrive in groups <Icon name="arrow" size={16} class="arrow" /></a>
        </p>
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="section bg-white/70">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="kicker reveal">What happens next</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Join now, <span class="accent">decide later</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          The priority list is the easiest way to stay in the loop. You’ll hear everything first, with no pressure to commit
          until the schedule is ready.
        </p>
      </div>
      <div class="mt-14">
        <SeasonTimeline />
      </div>
    </div>
  </section>

  <!-- Sound checker -->
  <section class="section" id="sound-check">
    <div class="container-x grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-32">
        <p class="kicker reveal">Free parent tool</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Is your child’s speech <span class="accent">on track?</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Tap your child’s age to see which sounds most kids can say by then. Every child is different, so think of it as a
          friendly guide, not a test.
        </p>
        <p class="mt-6 reveal" style="--i:3">
          <a href="/speech-sound-chart/" class="text-link">Full chart, examples, and tips <Icon name="arrow" size={16} class="arrow" /></a>
        </p>
        <div class="mt-12 pl-2 reveal lg:mt-14" style="--i:4">
          <Bird bubble perch class="w-28! lg:w-36!" />
        </div>
      </div>
      <div class="card card-featured reveal p-5 sm:p-8">
        <SoundChecker id="home-checker" />
      </div>
    </div>
  </section>

  <!-- Priority list -->
  <section class="pb-20 md:pb-28">
    <div class="container-x">
      <div class="callout reveal relative overflow-hidden px-6 py-12 sm:px-10 md:px-14 md:py-16">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:items-center">
          <div>
            <p class="kicker">Priority list</p>
            <h2 class="h2 mt-3">Be first in line <span class="accent">when groups open</span></h2>
            <p class="lead mt-5">
              Groups will be small, so spots are limited. Priority list families hear first, choose first, and get a little
              something from me every month until we begin.
            </p>
            <a href="/register/" class="btn btn-primary btn-lg mt-8">
              Join the priority list
              <Icon name="arrow" class="arrow" size={20} />
            </a>
          </div>
          <ul class="ledger" style="--cols:2">
            {
              listPerks.map((perk, i) => (
                <li class="reveal" style={`--i:${i + 1}`}>
                  <span class="icon-badge icon-badge-white">
                    <Icon name={perk.icon} size={22} strokeWidth={1.6} />
                  </span>
                  <h3 class="text-[1.2rem]!">{perk.title}</h3>
                  <p class="text-[0.98rem]">{perk.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Molly -->
  <section class="section bg-white/70">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="mx-auto w-full max-w-[22rem] pl-1 pr-3 reveal sm:px-0">
        <div class="arch-frame">
          <div class="arch aspect-[4/5]">
            <Image
              src={mollyPortrait}
              alt="Molly Kolarik, pediatric speech-language pathologist"
              widths={[360, 540, 760]}
              width={760}
              sizes="(min-width: 1024px) 22rem, 80vw"
              class="object-[50%_20%]"
            />
          </div>
        </div>
      </div>
      <div>
        <p class="kicker reveal">Meet Molly</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Hi, I’m Molly. <span class="accent">I can’t wait to meet your child.</span></h2>
        <div class="mt-6 space-y-4 reveal" style="--i:2">
          <p>
            I’m an experienced pediatric <span class="whitespace-nowrap">speech-language</span> pathologist and a Kansas City mom. I specialize in speech sounds:
            helping kids who are hard to understand, swap one sound for another, or get stuck on tricky sounds.
          </p>
          <p>
            As a mom, I know the feeling of wondering whether your child is on track, and whether to “wait and see.” Sound
            Groups are my new way of bringing that expertise to more families, because getting help shouldn’t feel
            complicated. Pick a time, show up, and I’ll handle the rest.
          </p>
        </div>
        <p class="mt-8 reveal" style="--i:3">
          <a href="/about/" class="text-link">More about me and my approach <Icon name="arrow" size={16} class="arrow" /></a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="kicker reveal">Questions</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Good questions, <span class="accent">honest answers</span></h2>
        <p class="mt-5 reveal" style="--i:2">
          Don’t see yours? <a href="/contact/" class="text-link">Ask me directly</a>. I’m happy to talk it through.
        </p>
      </div>
      <Faq items={[faqs.start, faqs.leader, faqs.where, faqs.ages, faqs.cost, faqs.commitment]} />
    </div>
  </section>

  <!-- From the blog -->
  <section class="pb-20 md:pb-28">
    <div class="container-x">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="kicker reveal">From The Nest</p>
          <h2 class="h2 mt-3 reveal" style="--i:1">Ideas for parents</h2>
        </div>
        <a href="/blog/" class="text-link hidden shrink-0 sm:inline">All posts <Icon name="arrow" size={16} class="arrow" /></a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-[1.3fr_1fr]">
        <a href={latest.href} class="card card-lift reveal group flex flex-col overflow-hidden" style="--i:1">
          <Image
            src={latest.image}
            alt={latest.imageAlt}
            widths={[480, 760]}
            width={760}
            sizes="(min-width: 768px) 34rem, 92vw"
            class="plate-card aspect-[16/8] w-full object-cover"
          />
          <div class="flex flex-1 flex-col p-7">
            <p class="text-sm text-muted">{latest.tag}<span class="sep"> <span aria-hidden="true">·</span> </span><span class="whitespace-nowrap">{latest.readTime}</span></p>
            <h3 class="mt-2 font-serif text-2xl transition-colors group-hover:text-sage-800">{latest.title}</h3>
            <p class="mt-3 flex-1">{latest.excerpt}</p>
            <span class="text-link mt-5">Read the post <Icon name="arrow" size={16} class="arrow" /></span>
          </div>
        </a>
        <a href="/speech-sound-chart/" class="card card-lift reveal group flex flex-col bg-sage-100! p-7" style="--i:2">
          <div>
            <p class="text-sm text-muted">Free parent tool</p>
            <h3 class="mt-2 font-serif text-2xl transition-colors group-hover:text-sage-800">Speech sound chart by age</h3>
            <p class="mt-3">
              When do kids learn r, s, and th? See which sounds most children can say at every age, with examples and
              simple tips.
            </p>
          </div>
          <ChartTeaser class="my-auto max-w-[13.5rem] py-6" />
          <span class="text-link pt-2">Try the chart <Icon name="arrow" size={16} class="arrow" /></span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>

<script>
  // Anything that moves on its own for more than a few seconds needs a way to stop it.
  const marquee = document.querySelector<HTMLElement>('[data-marquee]');
  const strip = marquee?.querySelector<HTMLElement>('.marquee');
  const toggle = marquee?.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
  toggle?.addEventListener('click', () => {
    const paused = toggle.getAttribute('aria-pressed') !== 'true';
    toggle.setAttribute('aria-pressed', String(paused));
    marquee?.toggleAttribute('data-paused', paused);
  });

  // It rests while it's off screen.
  if (strip) {
    new IntersectionObserver(([entry]) => strip.classList.toggle('is-offscreen', !entry.isIntersecting)).observe(strip);
  }

  // With reduced motion the strip is a still row people scroll themselves, so keyboards need to reach it.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const syncScrollable = () => {
    if (!strip) return;
    if (reducedMotion.matches) {
      strip.tabIndex = 0;
      strip.setAttribute('role', 'region');
      strip.setAttribute('aria-label', 'Photo row, scroll for more');
    } else {
      strip.removeAttribute('tabindex');
      strip.removeAttribute('role');
      strip.removeAttribute('aria-label');
    }
  };
  syncScrollable();
  reducedMotion.addEventListener('change', syncScrollable);
</script>
