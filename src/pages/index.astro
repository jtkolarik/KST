---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Bird from '../components/Bird.astro';
import BranchDivider from '../components/BranchDivider.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import SeasonTimeline from '../components/SeasonTimeline.astro';
import SoundChecker from '../components/SoundChecker.astro';
import { faqs, listPerks, site } from '../data/site';
import { posts } from '../data/posts';
import heroPhoto from '../assets/images/hero-group-portrait.jpg';
import mollyPortrait from '../assets/images/headshot-portrait.png';
import ashaBadge from '../assets/images/asha-certified.png';
import kidsIllustration from '../assets/images/blog-group-therapy.png';
import gallery2 from '../assets/images/gallery-2.jpg';
import gallery3 from '../assets/images/gallery-3.jpg';
import gallery4 from '../assets/images/gallery-4.jpg';
import gallery5 from '../assets/images/gallery-5.jpg';
import gallery6 from '../assets/images/gallery-6.jpg';

const gallery = [
  { src: gallery2, alt: 'Molly reading a picture book with a young boy in a park', r: '-2deg' },
  { src: gallery3, alt: 'A smiling girl sitting in the grass during an outdoor activity', r: '1.5deg' },
  { src: gallery4, alt: 'Molly reading a story with a young girl at home', r: '-1deg' },
  { src: gallery5, alt: 'Molly and a boy laughing together during a play-based activity', r: '2deg' },
  { src: gallery6, alt: 'Molly walking hand in hand with two young girls in a park', r: '-1.5deg' },
];

const whatCards = [
  {
    icon: 'friends',
    title: 'Small groups',
    text: 'Kids practice with a few peers working on similar sounds, so speech practice feels normal and even fun.',
  },
  {
    icon: 'clock',
    title: '30 playful minutes',
    text: "Games, stories, and movement built around your child's sounds. Long enough for real practice, short enough to stay fun.",
  },
  {
    icon: 'tag',
    title: '$50 a session',
    text: 'Simple private pay. No insurance paperwork and no long-term contract.',
  },
] as const;

const groupPoints = [
  'Kids learn by hearing each other try',
  'Practice feels like play, not a test',
  'Confidence grows when no one feels singled out',
];

const latest = posts[0];
---

<Layout title="Speech Sound Groups for Kids in Kansas City">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x grid items-center gap-16 pb-20 pt-8 lg:grid-cols-[1.06fr_0.94fr] lg:gap-14 lg:pb-28 lg:pt-12">
      <div class="max-w-[38rem]">
        <p class="eyebrow load-in">
          <span class="live-dot" aria-hidden="true"></span>
          New: Sound Groups · <span class="sm:hidden">Priority list open</span><span class="hidden sm:inline">Priority list now open</span>
        </p>
        <h1 class="display mt-6 load-in" style="--d:1">
          Help your child <span class="accent">find their <span class="squiggle-wrap">voice<svg
                class="squiggle"
                viewBox="0 0 200 20"
                preserveAspectRatio="none"
                aria-hidden="true"><path pathLength="1" d="M4 13C40 5 70 17 104 10s56-7 92 2"></path></svg
              ></span></span>
        </h1>
        <p class="lead mt-6 load-in" style="--d:2">
          Sound Groups are a new way to work on speech sounds: small, play-based sessions where kids practice together,
          led by an experienced pediatric speech-language pathologist. Think swim lessons, but for speech.
        </p>
        <div class="mt-9 flex flex-wrap gap-3 load-in" style="--d:3">
          <a href="/register/" class="btn btn-primary btn-lg">
            Join the priority list
            <Icon name="arrow" class="arrow" size={20} />
          </a>
          <a href="/speech-sound-chart/" class="btn btn-secondary btn-lg">Check your child's sounds</a>
        </div>
        <ul class="reassure mt-6 load-in" style="--d:4">
          <li><Icon name="check" size={18} strokeWidth={2.2} />Free to join</li>
          <li><Icon name="check" size={18} strokeWidth={2.2} />No commitment</li>
          <li><Icon name="check" size={18} strokeWidth={2.2} />Takes 2 minutes</li>
        </ul>
      </div>

      <div class="relative mx-auto w-full max-w-[25rem] sm:max-w-[28rem] lg:mr-4 lg:max-w-[30rem]">
        <div class="arch-frame">
          <div class="arch arch-reveal aspect-[4/4.7]">
            <Picture
              src={heroPhoto}
              formats={['avif', 'webp']}
              widths={[420, 640, 860, 1100]}
              width={1100}
              sizes="(min-width: 1024px) 30rem, (min-width: 640px) 28rem, 90vw"
              alt="Molly Kolarik telling a felt-board story to three young children under a tree"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <div class="absolute -left-3 top-[8%] load-in sm:-left-10" style="--d:5">
          <div class="float-a flex items-center gap-3 rounded-2xl border-[1.5px] border-sage-200 bg-white py-2.5 pl-2.5 pr-4 shadow-[var(--shadow-offset),var(--shadow-soft)]">
            <Image src={ashaBadge} alt="" width={40} densities={[1, 2]} />
            <span class="text-sm leading-tight text-ink">
              <strong class="block">Molly Kolarik</strong>
              <span class="text-muted">M.S., CCC-SLP</span>
            </span>
          </div>
        </div>
        <div class="absolute -bottom-6 -left-2 load-in sm:-left-10" style="--d:6">
          <div class="stat-card float-b">
            <div><strong>$50</strong><span>per session</span></div>
            <div><strong>30</strong><span>minutes</span></div>
            <div><strong>3+</strong><span>years old</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-tan bg-white/60" aria-label="About Molly at a glance">
    <ul class="container-x flex flex-wrap items-center justify-center gap-x-10 gap-y-3 py-5 text-[0.95rem] text-muted">
      <li class="inline-flex items-center gap-2"><Icon name="sparkle" size={20} class="text-sage-600" />Experienced pediatric SLP</li>
      <li class="inline-flex items-center gap-2"><Icon name="cap" size={20} class="text-sage-600" />M.S., CCC-SLP</li>
      <li class="inline-flex items-center gap-2"><Icon name="shield" size={20} class="text-sage-600" />ASHA certified</li>
      <li class="inline-flex items-center gap-2"><Icon name="heart" size={20} class="text-sage-600" />Kansas City mom</li>
    </ul>
  </section>

  <!-- What is a Sound Group -->
  <section class="section">
    <div class="container-x">
      <BranchDivider class="mb-10" />
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker reveal">What's a Sound Group?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Like swim lessons, but for <span class="accent">speech sounds</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Kids learn alongside a few peers, with expert guidance, in a setting that feels like an activity rather than an
          appointment.
        </p>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          whatCards.map((card, i) => (
            <article class="card card-lift reveal p-8" style={`--i:${i}`}>
              <span class="icon-badge">
                <Icon name={card.icon} size={26} />
              </span>
              <h3 class="mt-6 text-xl">{card.title}</h3>
              <p class="mt-2">{card.text}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-center reveal">
        <a href="/sound-groups/" class="text-link">How Sound Groups work <span class="arrow">→</span></a>
      </p>
    </div>
  </section>

  <!-- Photo strip -->
  <section class="bg-sage-100/70 py-8" aria-label="Photos of Molly with children">
    <div class="marquee">
      <div class="marquee-track">
        {
          [...gallery, ...gallery].map((photo, i) => (
            <figure class="polaroid" style={`--r:${photo.r}`} aria-hidden={i >= gallery.length ? 'true' : undefined}>
              <Image
                src={photo.src}
                alt={i >= gallery.length ? '' : photo.alt}
                widths={[300, 560]}
                width={560}
                sizes="(min-width: 768px) 17rem, 13rem"
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why groups -->
  <section class="section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="relative reveal">
        <div class="overflow-hidden rounded-[2rem] border-[1.5px] border-sage-200 shadow-[6px_6px_0_var(--color-sage-200)]">
          <Image
            src={kidsIllustration}
            alt="Illustration of three young children sitting together and talking"
            widths={[480, 760, 1100]}
            width={1100}
            sizes="(min-width: 1024px) 34rem, 92vw"
            class="h-auto w-full"
          />
        </div>
        <span class="eyebrow absolute -bottom-5 right-5 bg-white!">
          <Icon name="friends" size={18} class="text-sage-600" />
          Better together
        </span>
      </div>
      <div>
        <p class="kicker reveal">Why groups?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Kids thrive <span class="accent">alongside peers</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Practicing with a few other kids makes speech work feel normal, social, and fun, and the progress carries into
          everyday conversations at school and at home.
        </p>
        <ul class="mt-8 space-y-4">
          {
            groupPoints.map((point, i) => (
              <li class="flex items-center gap-4 text-ink reveal" style={`--i:${i + 3}`}>
                <span class="check-dot">
                  <Icon name="check" size={15} strokeWidth={2.6} />
                </span>
                {point}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 reveal" style="--i:6">
          <a href="/blog/why-kids-thrive-in-group-speech-therapy/" class="text-link">Why kids thrive in groups <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- What happens next -->
  <section class="section bg-white/70">
    <div class="container-x">
      <div class="max-w-2xl">
        <p class="kicker reveal">What happens next</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Join now, <span class="accent">decide later</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          The priority list is the easiest way to stay in the loop. You'll hear everything first, with no pressure to commit
          until the schedule is ready.
        </p>
      </div>
      <div class="mt-14">
        <SeasonTimeline />
      </div>
    </div>
  </section>

  <!-- Sound checker -->
  <section class="section" id="sound-check">
    <div class="container-x grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start lg:gap-16">
      <div class="lg:sticky lg:top-32">
        <p class="kicker reveal">Free parent tool</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Is your child's speech <span class="accent">on track?</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          Tap your child's age to see which sounds most kids can say by then. Every child is different, so think of it as a
          friendly guide, not a test.
        </p>
        <p class="mt-6 reveal" style="--i:3">
          <a href="/speech-sound-chart/" class="text-link">Full chart, examples, and tips <span class="arrow">→</span></a>
        </p>
        <div class="mt-12 pl-2 reveal lg:mt-14" style="--i:4">
          <Bird bubble perch class="w-28! lg:w-36!" />
        </div>
      </div>
      <div class="card reveal p-5 sm:p-8">
        <SoundChecker id="home-checker" />
      </div>
    </div>
  </section>

  <!-- Priority list -->
  <section class="pb-20 md:pb-28">
    <div class="container-x">
      <div class="callout reveal relative overflow-hidden px-6 py-12 sm:px-10 md:px-14 md:py-16">
        <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:items-center">
          <div>
            <p class="pill"><Icon name="sparkle" size={14} strokeWidth={2.2} />Priority list</p>
            <h2 class="h2 mt-5">Be first in line <span class="accent">when groups open</span></h2>
            <p class="lead mt-5">
              Groups will be small, so spots are limited. Priority list families hear first, choose first, and get a little
              something from me every month until we begin.
            </p>
            <a href="/register/" class="btn btn-primary btn-lg mt-8">
              Join the priority list
              <Icon name="arrow" class="arrow" size={20} />
            </a>
          </div>
          <ul class="grid gap-4 sm:grid-cols-2">
            {
              listPerks.map((perk, i) => (
                <li class="perk reveal rounded-3xl bg-white/80 p-6" style={`--i:${i + 1}`}>
                  <span class="icon-badge bg-white!">
                    <Icon name={perk.icon} size={24} />
                  </span>
                  <h3 class="mt-4 text-lg">{perk.title}</h3>
                  <p class="mt-1.5 text-[0.98rem]">{perk.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Meet Molly -->
  <section class="section bg-white/70">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="relative mx-auto w-full max-w-[22rem] reveal">
        <div class="arch-frame">
          <div class="arch aspect-[4/5]">
            <Image
              src={mollyPortrait}
              alt="Molly Kolarik, pediatric speech-language pathologist"
              widths={[360, 540, 760]}
              width={760}
              sizes="(min-width: 1024px) 22rem, 80vw"
              class="object-[50%_20%]"
            />
          </div>
        </div>
        <div class="absolute -bottom-5 -right-3 flex items-center gap-3 rounded-2xl border-[1.5px] border-sage-200 bg-white px-4 py-3 shadow-[var(--shadow-soft)] sm:-right-8">
          <Image src={ashaBadge} alt="" width={44} densities={[1, 2]} />
          <span class="text-sm leading-tight text-ink"><strong class="block">ASHA certified</strong>CCC-SLP</span>
        </div>
      </div>
      <div>
        <p class="kicker reveal">Meet Molly</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Hi, I'm Molly. <span class="accent">I can't wait to meet your child.</span></h2>
        <div class="mt-6 space-y-4 reveal" style="--i:2">
          <p>
            I'm an experienced pediatric speech-language pathologist and a Kansas City mom. I specialize in speech sounds:
            helping kids who are hard to understand, swap one sound for another, or get stuck on tricky sounds.
          </p>
          <p>
            As a mom, I know the feeling of wondering whether your child is on track, and whether to "wait and see." Sound
            Groups are my new way of bringing that expertise to more families, because getting help shouldn't feel
            complicated. Pick a time, show up, and I'll handle the rest.
          </p>
        </div>
        <p class="mt-8 reveal" style="--i:3">
          <a href="/about/" class="text-link">More about me and my approach <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="kicker reveal">Questions</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Good questions, <span class="accent">honest answers</span></h2>
        <p class="mt-5 reveal" style="--i:2">
          Don't see yours? <a href="/contact/" class="text-link">Ask me directly</a>. I'm happy to talk it through.
        </p>
      </div>
      <Faq items={[faqs.start, faqs.leader, faqs.where, faqs.ages, faqs.cost, faqs.commitment]} />
    </div>
  </section>

  <!-- From the blog -->
  <section class="pb-20 md:pb-28">
    <div class="container-x">
      <div class="flex items-end justify-between gap-6">
        <div>
          <p class="kicker reveal">From The Nest</p>
          <h2 class="h2 mt-3 reveal" style="--i:1">Ideas for parents</h2>
        </div>
        <a href="/blog/" class="text-link hidden shrink-0 sm:inline">All posts <span class="arrow">→</span></a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <a href={latest.href} class="card card-lift reveal group flex flex-col overflow-hidden" style="--i:1">
          <Image
            src={latest.image}
            alt={latest.imageAlt}
            widths={[480, 760]}
            width={760}
            sizes="(min-width: 768px) 34rem, 92vw"
            class="aspect-[16/8] w-full object-cover"
          />
          <div class="flex flex-1 flex-col p-7">
            <p class="text-sm text-muted">{latest.tag} · {latest.readTime}</p>
            <h3 class="mt-2 font-serif text-2xl transition-colors group-hover:text-sage-800">{latest.title}</h3>
            <p class="mt-3 flex-1">{latest.excerpt}</p>
            <span class="text-link mt-5">Read the post <span class="arrow">→</span></span>
          </div>
        </a>
        <a href="/speech-sound-chart/" class="card card-lift reveal group flex flex-col justify-between bg-sage-100! p-7" style="--i:2">
          <div>
            <p class="text-sm text-muted">Free parent tool</p>
            <h3 class="mt-2 font-serif text-2xl transition-colors group-hover:text-sage-800">Speech sound chart by age</h3>
            <p class="mt-3">
              When do kids learn r, s, and th? See which sounds most children can say at every age, with examples and
              simple tips.
            </p>
          </div>
          <div class="mt-8 flex flex-wrap gap-2" aria-hidden="true">
            {['p', 'm', 'k', 's', 'sh', 'l', 'r', 'th'].map((s, i) => (
              <span
                class="grid h-12 w-12 place-items-center rounded-xl border-[1.5px] border-sage-400 bg-white font-serif text-xl font-semibold text-ink transition-transform duration-300 group-hover:-translate-y-1"
                style={`transition-delay:${i * 30}ms`}
              >
                {s}
              </span>
            ))}
          </div>
          <span class="text-link mt-6">Try the chart <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
