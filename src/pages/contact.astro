---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { faqs, site } from '../data/site';
import readingPhoto from '../assets/images/gallery-4.jpg';

const ages = ['2', '3', '4', '5', '6', '7', '8', '9+'];
const [emailUser, emailDomain] = site.email.split('@');
---

<Layout
  title="Contact"
  description="Questions about Sound Groups or your child’s speech? Get in touch with Molly Kolarik, CCC-SLP, an experienced pediatric speech-language pathologist in Kansas City."
>
  <section class="relative isolate overflow-clip">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x pb-20 pt-10 lg:pb-28 lg:pt-14">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow load-in">
          <Icon name="chat" size={16} class="text-sage-600" />
          I typically reply within a day
        </p>
        <h1 class="display mt-6 load-in" style="--d:1">Let’s <span class="accent">talk</span></h1>
        <p class="lead mt-6 load-in" style="--d:2">
          Wondering if Sound Groups are right for your child, or just have a question? I’d love to hear from you.
        </p>
        <p class="mt-4 load-in" style="--d:3">
          Want to hear first when groups open? <a href="/register/" class="text-link">Join the priority list <Icon name="arrow" size={16} class="arrow" /></a>
        </p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-start">
        <div class="card p-6 load-in sm:p-10" style="--d:3">
          <h2 class="font-serif text-3xl">Send a message</h2>
          <form
            name="contact"
            method="POST"
            action="/message-sent/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mt-7 space-y-6"
            data-contact-form
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <div>
              <label for="name" class="field-label">Your name</label>
              <input id="name" name="name" type="text" required autocomplete="name" class="field" />
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="email" class="field-label">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@email.com" />
              </div>
              <div>
                <label for="phone" class="field-label">Phone <span class="optional">(optional)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" class="field" placeholder="(555) 555-5555" />
              </div>
            </div>
            <div>
              <label for="child-age" class="field-label">Child’s age <span class="optional">(optional)</span></label>
              <select id="child-age" name="child-age" class="field">
                <option value="">Select</option>
                {ages.map((age) => <option value={age}>{age}</option>)}
              </select>
            </div>
            <div>
              <label for="message" class="field-label">What’s on your mind?</label>
              <textarea id="message" name="message" rows="5" required class="field resize-none"></textarea>
              <p class="field-hint">Please don’t include medical, diagnostic, or detailed clinical information here.</p>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-full sm:w-auto" data-submit>
              <span data-submit-label>Send message</span>
              <Icon name="arrow" class="arrow" size={20} />
            </button>
          </form>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-28">
          <div class="card p-7 load-in" style="--d:4">
            <h2 class="font-sans text-lg font-semibold">Get in touch</h2>
            <ul class="mt-5 space-y-5">
              <li class="flex items-start gap-3.5">
                <span class="icon-badge h-11! w-11!"><Icon name="phone" size={20} /></span>
                <div>
                  <p class="text-sm text-muted">Call or text</p>
                  <a href="/contact/" class="phone-link font-semibold text-sage-700 hover:text-sage-800"><span class="phone-text"></span></a>
                </div>
              </li>
              <li class="flex items-start gap-3.5">
                <span class="icon-badge h-11! w-11!"><Icon name="mail" size={20} /></span>
                <div class="min-w-0">
                  <p class="text-sm text-muted">Email</p>
                  <a href={`mailto:${site.email}`} class="font-semibold text-sage-700 [overflow-wrap:anywhere] hover:text-sage-800">{emailUser}<wbr />@{emailDomain}</a>
                </div>
              </li>
              <li class="flex items-start gap-3.5">
                <span class="icon-badge h-11! w-11!"><Icon name="pin" size={20} /></span>
                <div>
                  <p class="text-sm text-muted">Service area</p>
                  <p class="font-semibold text-ink">{site.area}</p>
                </div>
              </li>
            </ul>
          </div>
          <div class="overflow-hidden rounded-[1.75rem] load-in" style="--d:5">
            <Image
              src={readingPhoto}
              alt="Molly reading a story with a young girl at home"
              widths={[400, 640, 900]} width={900}
              sizes="(min-width: 1024px) 24rem, 92vw"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-white/70">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="kicker reveal">Questions</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Quick answers</h2>
      </div>
      <Faq items={[faqs.needsHelp, faqs.start, faqs.cost, faqs.insurance, faqs.ages]} />
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', () => {
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    if (!button || !label) return;
    label.textContent = 'Sending…';
    button.setAttribute('aria-disabled', 'true');
  });
</script>
