---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { listPerks, site } from '../data/site';

const ages = ['3', '4', '5', '6', '7', '8', '9+', 'Not sure'];
const times = ['Weekday mornings', 'Weekday afternoons', 'Evenings', 'Saturdays'];
const sources = ['Google search', 'AI assistant (ChatGPT, Gemini, etc.)', 'A friend or family member', 'Pediatrician or doctor', 'Preschool, daycare, or school', 'Facebook or Instagram', 'A flyer', 'Other'];
---

<Layout
  title="Join the Sound Groups Priority List"
  description="Join the free priority list for Kansas City Sound Groups. Hear first when groups open, get first pick of group times, and receive a monthly at-home sound game."
>
  <section class="relative isolate overflow-hidden">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x pb-20 pt-10 lg:pb-28 lg:pt-14">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow load-in">
          <span class="live-dot" aria-hidden="true"></span>
          Free · No commitment
        </p>
        <h1 class="display mt-6 load-in" style="--d:1">Join the <span class="accent">priority list</span></h1>
        <p class="lead mt-6 load-in" style="--d:2">
          Tell me a little about your child. You’ll hear first when Sound Groups open, get first pick of group times, and
          receive a playful at-home sound game each month until we begin.
        </p>
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[1.35fr_0.65fr] lg:items-start">
        <div class="card p-6 load-in sm:p-10" style="--d:3">
          <form
            name="registration"
            method="POST"
            action="/success/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-7"
            data-join-form
          >
            <input type="hidden" name="form-name" value="registration" />
            <p class="hidden">
              <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div class="grid gap-5 sm:grid-cols-2">
              <div class="sm:col-span-2">
                <label for="parent-name" class="field-label">Your name</label>
                <input id="parent-name" name="parent-name" type="text" required autocomplete="name" class="field" />
              </div>
              <div>
                <label for="email" class="field-label">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" class="field" placeholder="you@email.com" />
              </div>
              <div>
                <label for="phone" class="field-label">Phone <span class="optional">(optional)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" class="field" placeholder="(555) 555-5555" />
              </div>
            </div>

            <div class="grid gap-5 sm:grid-cols-3">
              <div>
                <label for="child-name" class="field-label">Child’s first name <span class="optional">(optional)</span></label>
                <input id="child-name" name="child-name" type="text" class="field" />
              </div>
              <div>
                <label for="child-age" class="field-label">Child’s age</label>
                <select id="child-age" name="child-age" required class="field">
                  <option value="">Select</option>
                  {ages.map((age) => <option value={age}>{age}</option>)}
                </select>
              </div>
              <div>
                <label for="zip" class="field-label">Home ZIP code</label>
                <input
                  id="zip"
                  name="zip"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  pattern="[0-9]{5}"
                  maxlength="5"
                  required
                  class="field"
                  placeholder="64113"
                />
              </div>
            </div>
            <p class="field-hint -mt-4 flex items-start gap-2">
              <Icon name="pin" size={16} class="mt-0.5 flex-none text-sage-600" />
              Your ZIP code helps me choose a location that’s close to as many families as possible.
            </p>

            <fieldset>
              <legend class="field-label">What times would usually work for your child? <span class="optional">(pick any)</span></legend>
              <div class="chip-group mt-1">
                {
                  times.map((time) => (
                    <label class="chip">
                      <input type="checkbox" name="preferred-times[]" value={time} />
                      <span class="chip-check" aria-hidden="true">
                        <Icon name="check" size={16} strokeWidth={2.6} />
                      </span>
                      {time}
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="interest" class="field-label">What are you interested in?</label>
                <select id="interest" name="interest" required class="field">
                  <option value="">Select one</option>
                  <option value="Sound Groups">Sound Groups</option>
                  <option value="Individual sessions">One-on-one sessions</option>
                  <option value="Not sure yet">Not sure yet</option>
                </select>
              </div>
              <div>
                <label for="heard-from" class="field-label">How did you hear about me? <span class="optional">(optional)</span></label>
                <select id="heard-from" name="heard-from" class="field">
                  <option value="">Select one</option>
                  {sources.map((source) => <option value={source}>{source}</option>)}
                </select>
              </div>
            </div>

            <div>
              <label for="buddy" class="field-label">Signing up with a friend? <span class="optional">(optional)</span></label>
              <input id="buddy" name="buddy" type="text" class="field" placeholder="Their child’s first name" />
              <p class="field-hint">I’ll do my best to place buddies in the same group.</p>
            </div>

            <div>
              <label for="note" class="field-label">Anything else? <span class="optional">(optional)</span></label>
              <textarea id="note" name="note" rows="3" class="field resize-none"></textarea>
              <p class="field-hint">Please don’t include medical, diagnostic, or detailed clinical information here.</p>
            </div>

            <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center sm:justify-between">
              <button type="submit" class="btn btn-primary btn-lg" data-submit>
                <span data-submit-label>Join the priority list</span>
                <Icon name="arrow" class="arrow" size={20} />
              </button>
              <p class="text-sm text-muted">Free · No commitment · Unsubscribe anytime</p>
            </div>
          </form>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-28">
          <div class="callout relative p-7">
            <p class="pill">What you’ll get</p>
            <ul class="mt-6 space-y-5">
              {
                listPerks.map((perk) => (
                  <li class="flex gap-3.5">
                    <span class="icon-badge h-11! w-11! bg-white!">
                      <Icon name={perk.icon} size={20} />
                    </span>
                    <div>
                      <p class="font-semibold text-ink">{perk.title}</p>
                      <p class="mt-0.5 text-[0.95rem]">{perk.text}</p>
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="card p-7">
            <p class="font-semibold text-ink">Questions first?</p>
            <p class="mt-1.5 text-[0.95rem]">I’m happy to chat about whether Sound Groups are a good fit.</p>
            <div class="mt-4 space-y-2.5">
              <a href="/contact/" class="phone-link flex items-center gap-2 font-semibold text-sage-700 hover:text-sage-800">
                <Icon name="phone" size={18} />
                <span class="phone-text"></span>
              </a>
              <a href={`mailto:${site.email}`} class="flex items-center gap-2 break-all font-semibold text-sage-700 hover:text-sage-800">
                <Icon name="mail" size={18} class="flex-none" />
                {site.email}
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Give clear feedback on submit and prevent double submissions.
  const form = document.querySelector<HTMLFormElement>('[data-join-form]');
  form?.addEventListener('submit', () => {
    const button = form.querySelector<HTMLButtonElement>('[data-submit]');
    const label = form.querySelector<HTMLElement>('[data-submit-label]');
    if (!button || !label) return;
    label.textContent = 'Saving your spot…';
    button.setAttribute('aria-disabled', 'true');
  });
</script>
