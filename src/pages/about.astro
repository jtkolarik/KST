---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import BranchDivider from '../components/BranchDivider.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import Keep from '../components/Keep.astro';
import { site } from '../data/site';
import mollyLake from '../assets/images/molly-lake-portrait.jpg';
import laughPhoto from '../assets/images/gallery-5.jpg';
import ashaBadge from '../assets/images/asha-certified.png';

const credentials = [
  { icon: 'cap', title: 'M.S., Speech-Language Pathology', text: 'University of Central Missouri' },
  { icon: 'shield', title: 'CCC-SLP', text: 'Certificate of Clinical Competence from ASHA' },
  { icon: 'pin', title: 'Licensed in Missouri', text: 'Serving families across the Kansas City metro' },
] as const;

const approach = [
  { icon: 'smile', title: 'Play-based', text: 'Therapy should feel like fun, not work. I use games, stories, and movement to build speech skills naturally.' },
  { icon: 'friends', title: 'Peer-powered', text: 'Kids learn best alongside other kids. Small groups build confidence and make practice feel normal.' },
  { icon: 'heart', title: 'Family-centered', text: "I keep you in the loop with simple ideas you can use at home between sessions, so progress keeps going." },
] as const;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.owner,
  jobTitle: 'Pediatric Speech-Language Pathologist',
  honorificSuffix: site.credentials,
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Central Missouri' },
  hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'Certificate of Clinical Competence in Speech-Language Pathology (CCC-SLP)' },
  worksFor: { '@type': 'Organization', name: site.name, url: site.url },
  url: `${site.url}/about/`,
};
---

<Layout
  title="About Molly Kolarik, CCC-SLP"
  description="Meet Molly Kolarik, M.S., CCC-SLP: an experienced pediatric speech-language pathologist and Kansas City mom bringing play-based Sound Groups to local families."
  schema={[person]}
  footerPromo={false}
>
  <section class="relative isolate overflow-clip">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x grid items-center gap-14 pb-20 pt-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pb-28 lg:pt-14">
      <div>
        <p class="eyebrow load-in">
          <Icon name="heart" size={16} class="text-sage-600" />
          About Molly
        </p>
        <h1 class="display mt-6 load-in" style="--d:1">Hi, I’m <span class="accent">Molly</span></h1>
        <p class="lead mt-6 max-w-xl load-in" style="--d:2">
          I’m an experienced pediatric <span class="whitespace-nowrap">speech-language</span> pathologist and a Kansas City mom. I specialize in speech sounds,
          helping kids speak clearly and confidently through play.
        </p>
        <ul class="ledger ledger-rows mt-8 max-w-xl load-in" style="--d:3">
          {
            credentials.map((c) => (
              <li>
                <span class="icon-badge"><Icon name={c.icon} size={22} /></span>
                <p class="font-semibold text-ink"><Keep text={c.title} /></p>
                <p class="mt-1 text-muted"><Keep text={c.text} /></p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-[24rem] pl-2 pr-3 sm:px-0">
        <div class="arch-frame">
          <div class="arch arch-reveal aspect-[4/5]">
            <Image
              src={mollyLake}
              alt="Molly Kolarik smiling by a lake"
              widths={[360, 560, 800]} width={800}
              sizes="(min-width: 1024px) 24rem, 85vw"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
        <span class="seal"><Image src={ashaBadge} alt="ASHA certified, CCC-SLP" width={80} densities={[1, 2]} /></span>
      </div>
    </div>
  </section>

  <section class="section bg-white/70">
    <div class="container-x max-w-3xl">
      <p class="kicker reveal">My background</p>
      <h2 class="h2 mt-3 reveal" style="--i:1">Helping kids <span class="accent">be understood</span></h2>
      <div class="mt-6 max-w-[36rem] space-y-5 text-[1.0625rem] reveal" style="--i:2">
        <p>
          I earned my Master’s degree in Speech-Language Pathology from the University of Central Missouri and hold my
          Certificate of Clinical Competence (CCC-SLP) from the American Speech-Language-Hearing Association.
        </p>
        <p>
          I’ve worked with children ages 3 and up, with a special focus on speech sounds: kids who are hard to understand,
          swap one sound for another, or struggle to say certain sounds clearly. I love finding creative, play-based ways to
          make practice feel like fun.
        </p>
      </div>
      <div class="margin-note max-w-[36rem] reveal" style="--i:3">
        <h3><Icon name="sprig" size={22} class="mr-2 inline-block align-[-0.12em] text-sage-600" />A new service, the same experience</h3>
        <p class="mt-3">
          During the school year I work as a school-based speech-language pathologist, helping kids with speech sounds every
          week. Sound Groups are a new way to bring that experience to more families, in a format that’s affordable, playful,
          and easy to start.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div class="reveal">
        <div class="overflow-hidden rounded-[2rem]">
          <Image
            src={laughPhoto}
            alt="Molly and a boy laughing together during a play-based activity"
            widths={[480, 760, 1100]} width={1100}
            sizes="(min-width: 1024px) 34rem, 92vw"
            class="aspect-[4/3] w-full object-cover object-[0%_50%]"
          />
        </div>
      </div>
      <div class="max-w-[36rem]">
        <p class="kicker reveal">Why Sound Groups</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Getting help <span class="accent">shouldn’t be hard</span></h2>
        <div class="mt-6 space-y-5 reveal" style="--i:2">
          <p>
            I’ve seen so many families struggle to get speech help for their child: complicated intake processes, confusing
            referrals, and costs that feel out of reach. I knew there had to be a better way.
          </p>
          <p>
            Sound Groups are my answer. Small group sessions that are affordable, easy to start, and genuinely fun for kids.
            No complicated paperwork and no insurance headaches, just good speech therapy your family can count on.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-white/70">
    <div class="container-x">
      <BranchDivider class="mb-10" />
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="h2 reveal">How I work with kids</h2>
      </div>
      <ul class="ledger mt-14">
        {
          approach.map((item, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <span class="icon-badge">
                <Icon name={item.icon} size={26} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="pt-20 md:pt-28">
    <CtaBand
      title="Let’s talk about your child"
      text="I’d love to hear your story. Join the Sound Groups priority list, or reach out with any questions."
    />
  </div>
</Layout>
