---
import { Image, Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { faqs, site } from '../data/site';
import walkPhoto from '../assets/images/gallery-6.jpg';
import mollyLake from '../assets/images/molly-lake-portrait.jpg';
import ashaBadge from '../assets/images/asha-certified.png';

const { groups, oneOnOne } = site;

const glance = [
  { value: `$${groups.price}`, label: 'per session' },
  { value: `${groups.minutes} min`, label: 'playful sessions' },
  { value: 'Small', label: 'groups' },
  { value: `${groups.minAge}+`, label: 'years old' },
];

const steps = [
  { title: 'Join the list', text: 'Tell me a little about your child. It takes about two minutes and costs nothing.' },
  { title: 'Pick your time', text: 'Priority list families choose group times first, before enrollment opens to everyone.' },
  { title: 'Show up and play', text: `Bring your child to a ${groups.minutes}-minute session. No prep needed; I handle the rest.` },
  { title: 'Watch them grow', text: 'Kids practice week after week alongside peers, and confidence follows.' },
];

const goodFit = [
  'Is hard for people outside the family to understand',
  'Swaps one sound for another, like “wabbit” for rabbit',
  'Leaves sounds off the beginning or end of words',
  'Has a lisp or a “slushy” s sound',
  'Gets frustrated when they aren’t understood',
  'Was told they didn’t qualify for speech at school, but you still hear errors',
];

const oneOnOneFit = [
  'Needs support with language, like understanding or putting words together',
  'Finds group settings overwhelming right now',
  'Needs more intensive, individualized practice to get started',
];

const whyGroups = [
  { icon: 'friends', title: 'Kids learn from each other', text: 'Hearing a peer try a sound helps children notice the difference in their own speech.' },
  { icon: 'chat', title: "It’s closer to real life", text: 'Practicing sounds while actually talking with other kids builds the bridge to everyday conversation.' },
  { icon: 'heart', title: 'Confidence grows in company', text: "Knowing they’re not the only one working on a sound is a big relief for a lot of kids." },
  { icon: 'sparkle', title: 'Motivation is contagious', text: "When one child has a breakthrough, the others notice. Kids cheer each other on." },
] as const;

const details = [
  { icon: 'calendar', label: 'When', value: `Opening ${site.launch.opens}. The priority list hears first and gets first pick of times.` },
  { icon: 'pin', label: 'Where', value: 'Kansas City. The location will be shared with the priority list first.' },
  { icon: 'friends', label: 'Who', value: `Kids ages ${groups.minAge} and up, matched by age and the sounds they are working on.` },
  { icon: 'tag', label: 'Payment', value: 'Simple private pay. No insurance paperwork and no long-term contract.' },
] as const;

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Speech Sound Groups',
  description: `Small-group speech therapy for children ages ${groups.minAge} and up in Kansas City, led by an experienced pediatric speech-language pathologist. Play-based ${groups.minutes}-minute sessions for $${groups.price}.`,
  provider: { '@type': 'Person', name: site.owner, jobTitle: 'Speech-Language Pathologist' },
  areaServed: { '@type': 'City', name: 'Kansas City' },
  offers: { '@type': 'Offer', price: String(groups.price), priceCurrency: 'USD' },
};
---

<Layout
  title="Speech Sound Groups"
  description={`Small, play-based speech sound groups for kids in Kansas City: $${groups.price} per ${groups.minutes}-minute session, led by ${site.owner}, CCC-SLP. Join the priority list to hear first when groups open.`}
  schema={[service]}
>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="hero-bg grain" aria-hidden="true"></div>
    <div class="container-x pb-14 pt-10 text-center lg:pt-16">
      <p class="eyebrow load-in">
        <span class="live-dot" aria-hidden="true"></span>
        {site.launch.status} · Priority list open
      </p>
      <h1 class="display mx-auto mt-6 max-w-4xl load-in" style="--d:1">
        Speech sessions your child will <span class="accent">look forward to</span>
      </h1>
      <p class="lead mx-auto mt-6 max-w-2xl load-in" style="--d:2">
        Sound Groups are small, play-based sessions where kids practice speech sounds together. Pick a time, show up, and
        I’ll handle the rest.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3 load-in" style="--d:3">
        <a href="/register/" class="btn btn-primary btn-lg">
          Join the priority list
          <Icon name="arrow" class="arrow" size={20} />
        </a>
        <a href="#fit" class="btn btn-secondary btn-lg">Is it right for my child?</a>
      </div>
      <dl class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-3 sm:grid-cols-4 load-in" style="--d:4">
        {
          glance.map((item) => (
            <div class="card px-4 py-5">
              <dt class="sr-only">{item.label}</dt>
              <dd>
                <span class="block font-serif text-3xl font-semibold text-ink">{item.value}</span>
                <span class="text-sm text-muted">{item.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="container-x pb-6">
      <div class="relative overflow-hidden rounded-[2.25rem] shadow-[var(--shadow-soft)] load-in" style="--d:5">
        <Picture
          src={walkPhoto}
          formats={['avif', 'webp']}
          alt="Molly walking hand in hand with two young girls in a park"
          widths={[640, 960, 1280, 1700]}
          width={1700}
          sizes="(min-width: 1184px) 70rem, 94vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/10] w-full object-cover object-[50%_60%] sm:aspect-[16/7]"
        />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker reveal">How it works</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Simple from <span class="accent">start to finish</span></h2>
      </div>
      <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="card card-lift reveal relative p-7" style={`--i:${i}`}>
              <span class="grid h-12 w-12 place-items-center rounded-full bg-sage-700 font-serif text-xl font-semibold text-white">
                {i + 1}
              </span>
              <h3 class="mt-5 text-xl">{step.title}</h3>
              <p class="mt-2">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fit -->
  <section class="section bg-white/70" id="fit">
    <div class="container-x">
      <div class="mx-auto max-w-2xl text-center">
        <p class="kicker reveal">Is it a fit?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Made for kids working on <span class="accent">speech sounds</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">You know your child best. Here’s a quick way to think about it.</p>
      </div>
      <div class="mt-14 grid gap-6 lg:grid-cols-[1.25fr_1fr]">
        <div class="callout reveal flex flex-col p-8 md:p-10">
          <h3 class="font-serif text-2xl">A great fit if your child…</h3>
          <ul class="mt-6 space-y-4">
            {
              goodFit.map((item) => (
                <li class="flex items-start gap-3.5 text-ink">
                  <span class="check-dot mt-0.5">
                    <Icon name="check" size={15} strokeWidth={2.6} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="price">
            <p class="price-line">
              <span class="price-name">Sound Groups</span>
              <span class="price-leader" aria-hidden="true"></span>
              <span class="price-amount">${groups.price}</span>
            </p>
            <p class="price-per">per {groups.minutes}-minute session</p>
          </div>
        </div>
        <div class="card reveal flex flex-col p-8 md:p-10" style="--i:1">
          <h3 class="font-serif text-2xl">One-on-one might be a better start if your child…</h3>
          <ul class="mt-6 space-y-4">
            {
              oneOnOneFit.map((item) => (
                <li class="flex items-start gap-3.5">
                  <span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-sage-400" />
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-8 rounded-2xl bg-cream px-5 py-4 text-[0.98rem] text-muted">
            Not sure? <a href="/contact/" class="text-link">Send me a note</a> and I’ll tell you honestly what I’d recommend.
          </p>
          <div class="price">
            <p class="price-line">
              <span class="price-name">One-on-one</span>
              <span class="price-leader" aria-hidden="true"></span>
              <span class="price-amount">${oneOnOne.price}</span>
            </p>
            <p class="price-per">per {oneOnOne.minutes}-minute session</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why groups -->
  <section class="section">
    <div class="container-x grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="kicker reveal">Why groups?</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Kids thrive <span class="accent">alongside peers</span></h2>
        <p class="lead mt-5 reveal" style="--i:2">
          One-on-one therapy has its place. But for speech sounds, practicing with a few other kids adds something a quiet
          therapy room can’t.
        </p>
        <p class="mt-6 reveal" style="--i:3">
          <a href="/blog/why-kids-thrive-in-group-speech-therapy/" class="text-link">Read why kids thrive in groups <span class="arrow">→</span></a>
        </p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          whyGroups.map((item, i) => (
            <article class="card card-lift reveal p-7" style={`--i:${i}`}>
              <span class="icon-badge">
                <Icon name={item.icon} size={24} />
              </span>
              <h3 class="mt-5 text-lg">{item.title}</h3>
              <p class="mt-1.5 text-[0.98rem]">{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The details so far -->
  <section class="pb-20 md:pb-28">
    <div class="container-x">
      <div class="card reveal relative overflow-hidden p-8 md:p-12">
        <p class="pill">{site.launch.status}</p>
        <h2 class="h2 mt-5 max-w-xl">What I can tell you <span class="accent">so far</span></h2>
        <dl class="mt-10 grid gap-x-10 gap-y-8 md:grid-cols-2">
          {
            details.map((item) => (
              <div class="flex gap-4">
                <span class="icon-badge">
                  <Icon name={item.icon} size={24} />
                </span>
                <div>
                  <dt class="font-semibold text-ink">{item.label}</dt>
                  <dd class="mt-1">{item.value}</dd>
                </div>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-white/70">
    <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="kicker reveal">Questions</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Common <span class="accent">questions</span></h2>
      </div>
      <Faq items={[faqs.ages, faqs.diagnosis, faqs.session, faqs.leader, faqs.moreSupport, faqs.insurance, faqs.start, faqs.where]} />
    </div>
  </section>

  <!-- Meet Molly -->
  <section class="section">
    <div class="container-x grid items-center gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="mx-auto w-full max-w-[20rem] reveal">
        <div class="arch-frame">
          <div class="arch aspect-[4/5]">
            <Image src={mollyLake} alt="Molly Kolarik, CCC-SLP" widths={[320, 480, 640]} width={640} sizes="(min-width: 1024px) 20rem, 80vw" />
          </div>
        </div>
      </div>
      <div>
        <p class="kicker reveal">Your child’s SLP</p>
        <h2 class="h2 mt-3 reveal" style="--i:1">Meet Molly Kolarik, <span class="accent">CCC-SLP</span></h2>
        <p class="mt-6 reveal" style="--i:2">
          I’m an experienced pediatric speech-language pathologist with a Master’s degree from the University of Central
          Missouri. I specialize in helping children master speech sounds, and Sound Groups are a new way I’m bringing that
          work to more Kansas City families.
        </p>
        <div class="mt-6 flex items-center gap-4 reveal" style="--i:3">
          <Image src={ashaBadge} alt="" width={56} densities={[1, 2]} />
          <p class="text-sm text-muted">Certified by the American Speech-Language-Hearing Association</p>
        </div>
        <p class="mt-8 reveal" style="--i:4">
          <a href="/about/" class="text-link">More about me <span class="arrow">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
