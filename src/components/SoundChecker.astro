---
// Interactive speech sound chart. Works without JavaScript (it renders the
// age-4 view); with JavaScript, picking an age animates the tiles.
import Icon from './Icon.astro';
import { soundBands, totalSounds } from '../data/sounds';

interface Props {
  id?: string;
  startAge?: number;
}

const { id = 'checker', startAge = 4 } = Astro.props;

const ages = [
  {
    value: 2,
    label: '2',
    message: "Lots of sounds are still on their way at 2, and that’s expected. Keep talking, reading, and playing together, and check back as your child grows.",
  },
  {
    value: 3,
    label: '3',
    message: 'Three-year-olds are still working on plenty of sounds. Everyday play and conversation are some of the best practice there is.',
  },
  {
    value: 4,
    label: '4',
    message: "By 4 to 5, most children are understood even by people who don’t know them well. If that’s not true for your child yet, it may be worth a conversation.",
  },
  {
    value: 5,
    label: '5',
    message: 'If your child is still working on sounds that most kids their age can say, a short conversation with a speech-language pathologist can give you clarity.',
  },
  {
    value: 6,
    label: '6',
    message: "By 6, most kids can say every sound on this chart. Still hearing “wabbit” for rabbit, or a lisp? That’s exactly what Sound Groups are for.",
  },
  {
    value: 7,
    label: '7+',
    message: 'Older kids can absolutely still master tricky sounds like r, s, and th. Practicing in a small group makes it feel normal, not like being singled out.',
  },
];

const tiles = soundBands.flatMap((band) => band.sounds.map((sound) => ({ ...sound, age: band.age })));
const readyAt = (age: number) => tiles.filter((t) => t.age <= age).length;
// Words the bird says when a parent picks an age: the sounds most kids gain
// at that age, or the late, tricky ones for 7+.
const sayFor = (age: number) =>
  tiles.filter((t) => (age >= 7 ? ['r', 's', 'l', 'th'].includes(t.label) : t.age === age)).map((t) => t.word);
const start = ages.find((a) => a.value === startAge) ?? ages[2];
---

<div class="checker" data-checker>
  <fieldset>
    <legend class="field-label mb-3">How old is your child?</legend>
    <div class="age-options">
      <span class="age-indicator" aria-hidden="true"></span>
      {
        ages.map((age) => (
          <label class="age-opt">
            <input
              type="radio"
              name={`${id}-age`}
              value={age.value}
              checked={age.value === start.value}
              data-label={String(age.value)}
              data-ready={readyAt(age.value)}
              data-message={age.message}
              data-say={JSON.stringify(sayFor(age.value))}
            />
            <span>
              <span class="sr-only">Age </span>
              {age.label}
            </span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <p class="mt-6 text-lg text-ink" aria-live="polite">
    By age <strong data-age-out>{start.label}</strong>, most kids can say
    <strong class="tabular-nums" data-count>{readyAt(start.value)}</strong> of {totalSounds} consonant sounds.
  </p>

  <ul class="sound-grid mt-5" aria-label="English consonant sounds">
    {
      tiles.map((tile) => (
        <li class="sound-tile" data-age={tile.age} data-state={tile.age <= start.value ? 'ready' : 'growing'}>
          <span class="tile-check" aria-hidden="true">
            <Icon name="check" size={12} strokeWidth={3} />
          </span>
          <span class="tile-sound">{tile.label}</span>
          <span class="tile-word">{tile.word[0]}<b>{tile.word[1]}</b>{tile.word[2]}</span>
          <span class="sr-only">
            {tile.note ? `(${tile.note}) ` : ''}most kids say this by age {tile.age}
          </span>
        </li>
      ))
    }
  </ul>

  <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted" aria-hidden="true">
    <span class="inline-flex items-center gap-2"><span class="legend-dot border-[1.5px] border-sage-400 bg-sage-100"></span>Most kids say this by now</span>
    <span class="inline-flex items-center gap-2"><span class="legend-dot border-[1.5px] border-dashed border-[#d9cdb8] bg-white"></span>Still developing, and that’s okay</span>
  </div>

  <div class="mt-6 rounded-2xl bg-cream px-5 py-4">
    <p class="text-[0.98rem] text-muted" data-message>{start.message}</p>
  </div>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-checker]').forEach((root) => {
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
    const tiles = [...root.querySelectorAll<HTMLElement>('.sound-tile')];
    const indicator = root.querySelector<HTMLElement>('.age-indicator');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const ageEl = root.querySelector<HTMLElement>('[data-age-out]');
    const messageEl = root.querySelector<HTMLElement>('[data-message]');
    let shown = Number(countEl?.textContent ?? 0);
    let frame = 0;

    const selected = () => inputs.find((input) => input.checked);

    const moveIndicator = () => {
      const label = selected()?.closest('label');
      if (!label || !indicator) return;
      indicator.style.setProperty('--x', `${label.offsetLeft}px`);
      indicator.style.setProperty('--w', `${label.offsetWidth}px`);
    };

    const countTo = (target: number) => {
      cancelAnimationFrame(frame);
      if (!countEl) return;
      if (reducedMotion.matches) {
        countEl.textContent = String(target);
        shown = target;
        return;
      }
      const from = shown;
      const startTime = performance.now();
      const step = (now: number) => {
        const t = Math.min((now - startTime) / 550, 1);
        const eased = 1 - Math.pow(1 - t, 3);
        shown = Math.round(from + (target - from) * eased);
        countEl.textContent = String(shown);
        if (t < 1) frame = requestAnimationFrame(step);
      };
      frame = requestAnimationFrame(step);
    };

    const update = () => {
      const input = selected();
      if (!input) return;
      const age = Number(input.value);
      const changed = tiles.filter((tile) => (Number(tile.dataset.age) <= age ? 'ready' : 'growing') !== tile.dataset.state);
      const fillingUp = changed.length > 0 && changed[0].dataset.state === 'growing';
      // Fill forward when the age goes up; empty backward when it goes down.
      (fillingUp ? changed : [...changed].reverse()).forEach((tile, order) => {
        tile.style.setProperty('--delay', reducedMotion.matches ? '0ms' : `${order * 45}ms`);
        tile.dataset.state = fillingUp ? 'ready' : 'growing';
        tile.classList.remove('is-flip');
        void tile.offsetWidth;
        tile.classList.add('is-flip');
      });
      if (ageEl) ageEl.textContent = input.dataset.label ?? input.value;
      if (messageEl) messageEl.textContent = input.dataset.message ?? '';
      countTo(Number(input.dataset.ready));
      moveIndicator();

      // Let the bird nearby say one of this age’s sounds.
      const words: string[][] = JSON.parse(input.dataset.say || '[]');
      if (words.length) {
        document.dispatchEvent(new CustomEvent('kst:say', { detail: words[Math.floor(Math.random() * words.length)] }));
      }
    };

    inputs.forEach((input) => input.addEventListener('change', update));
    window.addEventListener('resize', moveIndicator, { passive: true });
    root.classList.add('is-ready');
    moveIndicator();
  });
</script>
