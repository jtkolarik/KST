---
// An organic section break, drawn in the same hand as the bird’s perch: a
// tapered bark stem that draws itself, and two-tone leaves on short stalks
// that unfurl when it scrolls into view.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Each leaf hangs off a short stalk: [stalk path, leaf position, leaf angle].
const leaves: [string, number, number, number][] = [
  ['M24 30.6C30 26 34 21 36 15', 36, 15, -80],
  ['', 36, 15.4, -12],
  ['M68 29.4l2.6 4.6', 70.6, 34, 48],
  ['M104 31.2l3.6-4.4', 107.6, 26.8, -44],
  ['M142 28.8l2.4 4.8', 144.4, 33.6, 40],
  ['M212 24.2l2.8-4.4', 215, 19.8, -40],
  ['M252 23.6l2.4 4.6', 254.4, 28.2, 42],
  ['', 306, 24.6, -6],
];

// The draw-on mask needs a unique id when several dividers share a page.
const mask = `branch-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['branch-divider', className]} data-reveal aria-hidden="true">
  <svg viewBox="0 0 320 48" fill="none">
    <mask id={mask} maskUnits="userSpaceOnUse" x="-4" y="0" width="328" height="48">
      <path
        class="branch-reveal"
        pathLength="1"
        d="M2 31C58 22 110 34 160 27s102-7 158-2"
        stroke="#fff"
        stroke-width="12"
        stroke-linecap="round"
      />
    </mask>
    <g mask={`url(#${mask})`}>
      <path
        d="M4 30.2C58 21.4 110 34 160 27.2S262 20.6 316 24.4l-.1.9C262 22.2 212 29 160 30 110 36.8 58 25.6 4.6 33.6z"
        fill="currentColor"
      />
      <path
        d="M10 30C62 22.4 110 33.2 160 26.6S262 20.4 308 24"
        stroke="var(--color-tan)"
        stroke-width=".6"
        stroke-linecap="round"
      />
      <g stroke="currentColor" stroke-linecap="round">
        {leaves.map(([stalk], i) => stalk && <path d={stalk} stroke-width={i === 0 ? 1.2 : 0.8} />)}
      </g>
    </g>
    {
      leaves.map(([, x, y, r], i) => (
        <g transform={`translate(${x} ${y}) rotate(${r})${i === leaves.length - 1 ? ' scale(.8)' : ''}`}>
          <g class="branch-leaf" style={`--i:${i}`}>
            <path d="M0 0C4.5-6.2 13.5-6.8 19.5-.4 13.8 6 4.8 6.4 0 0z" />
            <path class="leaf-light" d="M0 0C5-5.6 13.6-6.2 19.5-.4 13-1.6 6-1.2 0 0z" />
            <path class="vein" d="M1.5 0C7-.9 12-.9 17.5-.4" />
          </g>
        </g>
      ))
    }
  </svg>
</div>
