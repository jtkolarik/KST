---
// A row of sound tiles that previews the speech sound chart. Place it inside a
// link with the "group" class: the tiles rise in a ripple when it's hovered.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const sounds = ['p', 'm', 'k', 's', 'sh', 'l', 'r', 'th'];
---

<div class:list={['flex flex-wrap gap-2', className]} aria-hidden="true">
  {
    sounds.map((s, i) => (
      <span
        class="grid h-12 w-12 place-items-center rounded-xl border-[1.5px] border-sage-400 bg-white font-serif text-xl font-semibold text-ink transition-[translate] duration-300 group-hover:-translate-y-1"
        style={`transition-delay:${i * 30}ms`}
      >
        {s}
      </span>
    ))
  }
</div>
