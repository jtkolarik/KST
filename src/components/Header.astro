---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logoBirds from '../assets/images/logo-birds.png';
import logoWordmark from '../assets/images/logo-wordmark.png';

const navLinks = [
  { name: 'Sound Groups', href: '/sound-groups/' },
  { name: 'Sound Chart', href: '/speech-sound-chart/' },
  { name: 'About Molly', href: '/about/' },
  { name: 'The Nest', href: '/blog/' },
  { name: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname.replace(/\/?$/, '/');

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href);
}
---

<header class="site-header" data-header>
  <div class="container-x header-inner flex items-center justify-between gap-4">
    <a href="/" class="logo-lockup" aria-label="Kolarik Speech Therapy, home">
      <Image src={logoBirds} alt="" class="logo-birds" height={106} densities={[1, 2]} loading="eager" />
      <Image src={logoWordmark} alt="" class="logo-word" height={84} densities={[1, 2]} loading="eager" />
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/register/" class="btn btn-primary btn-sm"><span>Join<span class="hidden sm:inline"> the list</span></span></a>
      <button
        type="button"
        class="menu-btn lg:hidden"
        data-menu-btn
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav lg:hidden" data-mobile-nav>
    <div>
      <nav aria-label="Mobile" class="container-x pb-8 pt-2">
        <ul class="divide-y divide-tan border-t border-tan">
          {
            navLinks.map((link, i) => (
              <li class="m-item" style={`--i:${i}`}>
                <a
                  href={link.href}
                  class="m-link flex items-center justify-between py-4 font-serif text-2xl text-ink"
                  aria-current={isActive(link.href) ? 'page' : undefined}
                  tabindex="-1"
                >
                  <span>{link.name}</span>
                  <Icon name="arrow" size={20} class="text-sage-600" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="m-item mt-6 grid gap-3 sm:grid-cols-2" style={`--i:${navLinks.length}`}>
          <a href="/register/" class="btn btn-primary btn-lg" tabindex="-1">Join the priority list</a>
          <a href="/contact/" class="btn btn-secondary btn-lg phone-link" tabindex="-1">
            <Icon name="phone" size={19} />
            <span class="phone-text"></span>
          </a>
        </div>
        <p class="m-item mt-5 text-center text-sm text-muted" style={`--i:${navLinks.length + 1}`}>
          Sound Groups are coming to Kansas City.
        </p>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const panelLinks = panel ? [...panel.querySelectorAll<HTMLElement>('a')] : [];

  const onScroll = () => header?.toggleAttribute('data-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('is-open', open);
    header?.toggleAttribute('data-open', open);
    panelLinks.forEach((link) => (open ? link.removeAttribute('tabindex') : link.setAttribute('tabindex', '-1')));
  };

  button?.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
  panelLinks.forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>
